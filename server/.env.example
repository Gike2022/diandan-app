# Project-owned local MySQL on port 3307; independent from an existing 3306 service.
DATABASE_URL=mysql://order_app:order_app_dev@127.0.0.1:3307/order_app
TEST_DATABASE_URL=mysql://order_app:order_app_dev@127.0.0.1:3307/order_app_test
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
APP_MODE=standard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEMO_PAYMENTS=true
# 15 minutes to pay; new orders keep their own deadline after configuration changes.
ORDER_PAYMENT_TIMEOUT_SECONDS=900
ORDER_EXPIRY_SWEEP_INTERVAL_MS=30000
# Relative to the server working directory, or set an absolute persistent directory.
UPLOAD_DIRECTORY=../.local/uploads/menu
IMAGE_STORAGE=filesystem
# Cloud deployment: enable both certificate and hostname verification.
DATABASE_SSL=false
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Serve the React build from the API process (paths relative to server/).
SERVE_FRONTEND=false
FRONTEND_DIRECTORY=../dist
TRUST_PROXY_HOPS=0
DEMO_ADMIN_PASSWORD=Admin12345!
DEMO_CUSTOMER_PASSWORD=Customer12345!

# Optional: full path to mysqld if it is not on PATH.
# MYSQLD_PATH=D:/MySQL/bin/mysqld.exe
